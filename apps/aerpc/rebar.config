%% -*- mode: erlang; erlang-indent-level: 4; indent-tabs-mode: nil -*-
%% lager_transform is stated explicitly rather than inherited: lager
%% exports no info/2 or error/2 of its own, so without the transform a
%% lager call in this app is an undefined function rather than a
%% compile error, and only xref would catch it.
{erl_opts, [debug_info, {parse_transform, lager_transform}]}.
